# ==============================================================================
# AERVISTO.COM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel, AWS Amplify, Docker), set these via the host dashboard.
# NEVER commit real credentials, secret API keys, or private emails to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SITE URL & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
# The public canonical URL of the website. Used for Open Graph, XML sitemaps,
# canonical tags, and structured data schemas.
# Safe to expose publicly (prefixed with NEXT_PUBLIC_).
NEXT_PUBLIC_SITE_URL=https://aervisto.com

# ------------------------------------------------------------------------------
# 2. CENTRALIZED TELEPHONE CONVERSION SYSTEM
# ------------------------------------------------------------------------------
# Centralized single phone number for agent-assisted customer calls.
SUPPORT_PHONE="+1 (844) 361-9076"
NEXT_PUBLIC_SUPPORT_PHONE="+1 (844) 361-9076"

# Desk operating hours displayed to customers (e.g. Mon-Sun: 7:00 AM - 11:00 PM EST)
NEXT_PUBLIC_SUPPORT_HOURS="Mon - Sun: 7:00 AM - 11:00 PM EST"

# Destination business email where customer enquiries are routed
SUPPORT_EMAIL=enquiries@aervisto.com
NEXT_PUBLIC_SUPPORT_EMAIL=enquiries@aervisto.com

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL PROVIDER (Server-Side Only - Private Credentials)
# ------------------------------------------------------------------------------
# Choose either "resend" or "brevo" for live flight enquiry email delivery.
# If left blank, enquiries will be logged safely to the server console in development mode.
# DO NOT add NEXT_PUBLIC_ prefix to these variables!

# Email service provider: "resend" or "brevo"
EMAIL_PROVIDER=resend

# API key for the chosen email provider
# Obtain from https://resend.com/api-keys or https://app.brevo.com/settings/keys/api
EMAIL_PROVIDER_API_KEY=

# Verified sender email address (e.g. enquiries@aervisto.com or quotes@aervisto.com)
# Must be a verified domain in your Resend/Brevo account.
EMAIL_FROM="Aervisto Flight Desk <enquiries@aervisto.com>"

# ------------------------------------------------------------------------------
# 4. GOOGLE ANALYTICS 4 & GOOGLE TAG MANAGER
# ------------------------------------------------------------------------------
# Configurable analytics tracking. Tracking scripts are only injected if these
# variables are present. The website functions completely normally without them.
# Safe to expose publicly (prefixed with NEXT_PUBLIC_).

# Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# ------------------------------------------------------------------------------
# 5. GOOGLE ADS CONVERSION TRACKING
# ------------------------------------------------------------------------------
# Used for firing Google Ads conversion events on qualified enquiries.
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
